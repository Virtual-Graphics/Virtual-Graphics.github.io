---
import BrandMark from "./BrandMark.astro";
import { orgUrl } from "../data/projects";

const navLinks = [
	{ href: "/#about", label: "关于" },
	{ href: "/#projects", label: "项目" },
	{ href: "/#join", label: "加入我们" },
];
---

<header>
	<div class="container header-inner">
		<a href="/" class="brand" aria-label="Virtual Graphics 首页">
			<BrandMark class="brand-mark" />
			<span>Virtual Graphics<span class="brand-caption">OPEN SOURCE · CG TOOLS</span></span>
		</a>
		<nav aria-label="主导航">
			{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			<a href={orgUrl} target="_blank" rel="noopener noreferrer" class="github-link">
				GitHub <span aria-hidden="true">↗</span>
			</a>
		</nav>
	</div>
</header>

<style>
	header { border-bottom: 1px solid var(--line); }
	.header-inner { display: flex; min-height: 88px; align-items: center; justify-content: space-between; gap: 24px; }
	.brand { display: inline-flex; align-items: center; gap: 14px; color: #f2f2f4; font-size: 15px; font-weight: 600; letter-spacing: -0.025em; }
	.brand :global(.brand-mark) { width: 35px; height: 32px; flex-shrink: 0; }
	.brand-caption { display: block; margin-top: 3px; color: #a0a0a8; font: 8px/1.5 Consolas, monospace; letter-spacing: 0.12em; }
	nav { display: flex; align-items: center; gap: 32px; font-size: 12px; }
	nav a { padding-block: 10px; color: #b5b5bd; }
	nav a:hover { color: #fff; }
	.github-link { display: inline-flex; align-items: center; gap: 18px; margin-left: 8px; padding-left: 28px; border-left: 1px solid var(--line); color: #eee; }
	@media (max-width: 640px) {
		.header-inner { min-height: 104px; flex-wrap: wrap; justify-content: center; gap: 8px; padding-block: 16px 10px; }
		.brand { margin-right: auto; }
		nav { width: 100%; justify-content: space-between; gap: 20px; }
		.github-link { padding-left: 20px; }
	}
</style>
