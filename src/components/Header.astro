---
import { orgUrl } from "../data/projects";

const navLinks = [
	{ href: "/#about", label: "关于" },
	{ href: "/#projects", label: "项目" },
	{ href: "/#join", label: "加入我们" },
];
---

<header class="border-b border-zinc-800">
	<div
		class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 text-sm"
	>
		<a href="/" class="font-semibold text-white">Virtual Graphics</a>
		<nav class="flex items-center gap-5 text-zinc-400">
			{
				navLinks.map((link) => (
					<a href={link.href} class="hover:text-white">
						{link.label}
					</a>
				))
			}
			<a href={orgUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white">
				GitHub
			</a>
		</nav>
	</div>
</header>
