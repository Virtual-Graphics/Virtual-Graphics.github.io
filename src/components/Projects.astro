---
import { projects, orgUrl } from "../data/projects";
---

<section id="projects" class="border-t border-zinc-800">
	<div class="mx-auto max-w-5xl px-4 py-16 sm:py-20">
		<h2 class="text-2xl font-bold text-white sm:text-3xl">项目</h2>
		<p class="mt-4 max-w-2xl leading-relaxed text-zinc-400">
			我们正在持续打磨自己的 CG Tools，以下是一些代表作。
		</p>

		<ul class="mt-10 space-y-8">
			{
				projects.map((project) => (
					<li>
						<a
							href={project.url}
							target="_blank"
							rel="noopener noreferrer"
							class="font-medium text-white hover:underline"
						>
							{project.name}
						</a>
						<p class="mt-1 max-w-2xl text-sm leading-relaxed text-zinc-400">
							{project.description}
						</p>
						<p class="mt-2 text-xs text-zinc-500">
							{project.tags.join(" · ")}
						</p>
					</li>
				))
			}
		</ul>

		<a
			href={orgUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="mt-8 inline-block text-sm text-zinc-400 hover:text-white"
		>
			查看全部仓库 →
		</a>
	</div>
</section>
