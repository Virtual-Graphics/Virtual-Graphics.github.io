---
import { orgUrl, tdsgUrl } from "../data/projects";

const year = new Date().getFullYear();

const links = [
	{ href: orgUrl, label: "GitHub" },
	{ href: tdsgUrl, label: "TDSG" },
	{ href: "https://github.com/Virtual-Graphics/.github", label: "组织简介" },
];
---

<footer class="border-t border-zinc-800">
	<div
		class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between"
	>
		<p>© {year} Virtual Graphics</p>
		<div class="flex items-center gap-6">
			{
				links.map((link) => (
					<a
						href={link.href}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-zinc-300"
					>
						{link.label}
					</a>
				))
			}
		</div>
	</div>
</footer>
