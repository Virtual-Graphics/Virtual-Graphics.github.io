---
import { orgUrl } from "../data/projects";

const disciplines = ["游戏引擎", "实时渲染", "物理仿真", "具身智能", "动画工具"];
---

<section class="hero" aria-labelledby="hero-title">
	<div class="container">
		<div class="hero-main">
			<div class="hero-copy">
				<p class="eyebrow hero-eyebrow"><span></span> OPEN SOURCE. OPEN POSSIBILITIES.</p>
				<h1 id="hero-title">Virtual<br /><span>Graphics</span><span class="title-period">.</span></h1>
				<p class="hero-tagline">为创作，构建更多可能。</p>
				<p class="hero-description">
					一个聚焦计算机图形学软件开发的开源非营利组织。<br class="desktop-break" />
					我们打造面向创作者的 CG Tools，让想象成为现实。
				</p>
				<div class="hero-actions">
					<a href="#projects" class="button">浏览项目 <span aria-hidden="true">↗</span></a>
					<a href={orgUrl} target="_blank" rel="noopener noreferrer" class="button button-secondary">
						GitHub 组织 <span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
			<div class="hero-art" aria-hidden="true">
				<div class="art-grid"></div>
				<div class="art-orbit orbit-outer"></div>
				<div class="art-orbit orbit-inner"></div>
				<span class="art-cross cross-top">+</span>
				<span class="art-cross cross-bottom">+</span>
				<span class="eyebrow art-label">VIRTUAL GRAPHICS / V.01</span>
				<img src="/logo-black.svg" alt="" width="480" height="480" fetchpriority="high" />
				<span class="eyebrow art-caption">FROM VERTICES TO POSSIBILITIES</span>
			</div>
		</div>
		<div class="disciplines">
			<span class="eyebrow disciplines-label">OUR FOCUS</span>
			<ul>{disciplines.map((discipline) => <li>{discipline}</li>)}</ul>
			<a href="#about" class="eyebrow explore">向下探索 <span aria-hidden="true">↓</span></a>
		</div>
	</div>
</section>

<style>
	.hero { overflow: hidden; }
	.hero-main { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: 24px; padding-block: 84px 76px; }
	.hero-copy { position: relative; z-index: 1; }
	.hero-eyebrow { display: flex; align-items: center; gap: 10px; color: #b9c6a6; font-size: 10px; letter-spacing: 0.13em; }
	.hero-eyebrow span { width: 5px; height: 5px; border-radius: 50%; background: #b9c6a6; box-shadow: 0 0 12px #b9c6a640; }
	h1 { margin-top: 26px; color: #f5f5f0; font-size: clamp(64px, 7.3vw, 96px); font-weight: 600; line-height: 0.98; letter-spacing: -0.075em; }
	h1 > span { color: #9a9a9e; }
	h1 .title-period { color: #d8ddc5; }
	.hero-tagline { margin-top: 28px; color: #e8e8e6; font-size: 22px; letter-spacing: 0.06em; }
	.hero-description { margin-top: 16px; font-size: 13px; line-height: 2; color: #a0a0a8; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
	.hero-art { position: relative; width: 100%; aspect-ratio: 1; display: grid; place-items: center; }
	.art-grid { position: absolute; inset: 0; background-image: linear-gradient(#ffffff07 1px, transparent 1px), linear-gradient(90deg, #ffffff07 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(ellipse, #000 24%, transparent 70%); }
	.art-orbit { position: absolute; border: 1px solid #ffffff0c; border-radius: 50%; }
	.orbit-outer { inset: 8%; }
	.orbit-inner { inset: 20%; border-style: dashed; transform: rotate(-25deg); }
	.hero-art img { position: relative; width: 100%; height: auto; filter: drop-shadow(0 20px 32px #ffffff0c); }
	.art-label, .art-caption { position: absolute; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 8px; color: #85858e; }
	.art-label { top: 8%; }
	.art-caption { bottom: 9%; }
	.art-cross { position: absolute; color: #73737b; font: 16px/1 monospace; }
	.cross-top { left: 12%; top: 22%; }
	.cross-bottom { right: 12%; bottom: 22%; }
	.disciplines { display: flex; align-items: center; gap: 34px; padding-block: 25px; border-top: 1px solid var(--line); }
	.disciplines-label { color: #85858e; font-size: 9px; }
	.disciplines ul { display: flex; flex-wrap: wrap; gap: 28px; font-size: 11px; color: #b5b5bc; }
	.explore { margin-left: auto; display: flex; gap: 24px; color: #96969f; font-size: 9px; letter-spacing: 0.08em; }
	.explore:hover { color: #fff; }
	@media (max-width: 900px) {
		.hero-main { padding-block: 64px; }
		.hero-art { width: 118%; margin-left: -9%; }
		.disciplines { gap: 24px; }
		.disciplines ul { gap: 20px; }
		.explore { display: none; }
	}
	@media (max-width: 640px) {
		.hero-main { grid-template-columns: 1fr; gap: 12px; padding-block: 48px 20px; }
		h1 { font-size: clamp(64px, 16vw, 88px); }
		.hero-tagline { font-size: 19px; }
		.hero-art { width: min(100%, 320px); margin: 0 auto; }
		.hero-description { font-size: 12px; }
		.desktop-break { display: none; }
		.disciplines { align-items: flex-start; gap: 20px; padding-block: 22px; }
		.disciplines-label { padding-top: 2px; flex-shrink: 0; }
		.disciplines ul { gap: 12px 20px; }
	}
</style>
