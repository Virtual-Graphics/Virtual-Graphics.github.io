---
import { orgUrl } from "../data/projects";
---

<section>
	<div class="mx-auto max-w-5xl px-4 py-20 sm:py-28">
		<h1 class="text-4xl font-bold text-white sm:text-5xl">Virtual Graphics</h1>
		<p class="mt-6 max-w-2xl leading-relaxed text-zinc-400">
			一个聚焦计算机图形学软件开发的开源非营利组织。我们热衷于打造面向创作者
			的 CG Tools —— 游戏引擎、渲染器、物理仿真软件、具身智能训练平台与动画
			制作工具。
		</p>
		<div class="mt-8 flex flex-wrap gap-4 text-sm">
			<a
				href="#projects"
				class="rounded-lg bg-white px-5 py-2.5 font-medium text-zinc-900"
			>
				浏览项目
			</a>
			<a
				href={orgUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-lg border border-zinc-700 px-5 py-2.5 font-medium text-zinc-200 hover:border-zinc-500"
			>
				GitHub 组织
			</a>
		</div>
	</div>
</section>
